# ============================================================
# GLOBALE PARAMETER
# ============================================================

# Audio-Parameter
SAMPLE_RATE = 16000       # Abtastrate in Hz – Standard für Sprach-/Audiomodelle
SEG_LEN_SEC = 1           # Länge eines Segments in Sekunden (Literatur-Standard)
SEG_LEN = SEG_LEN_SEC * SAMPLE_RATE  # = 16000 Samples pro Segment

# Mel-Spektrogramm-Parameter
N_MELS = 128              # Anzahl der Mel-Frequenzbänder (Auflösung auf der Frequenzachse)
HOP_LENGTH = 256          # Schrittweite zwischen zwei Spektrogramm-Frames (ca. 16 ms)
IMG_SIZE = 96             # 96×96 reicht für Spektrogramme völlig aus und ist ~5× schneller als 224×224

# Ob Debug-Spektrogramme als PNG gespeichert werden sollen
SAVE_MFCC_PNGS = True
MFCC_DEBUG_ROOT = "MFCCs"

# ImageNet-Normalisierungswerte: Diese Mittelwerte und Standardabweichungen wurden
# auf dem gesamten ImageNet-Datensatz berechnet. Da MobileNetV3 darauf vortrainiert
# wurde, müssen wir unsere Spektrogramm-Bilder genauso normalisieren.
IMAGENET_MEAN = torch.tensor([0.485, 0.456, 0.406], dtype=torch.float32).view(3, 1, 1)
IMAGENET_STD  = torch.tensor([0.229, 0.224, 0.225], dtype=torch.float32).view(3, 1, 1)

# Pfade zu den Daten (Ordner mit "drone" und "no drone" Unterordnern)
DATA_ROOT = "d:/Dropbox/03 H2 Think/AuDroK mFund/Auswertungen/Datensätze/Drone vs. No Drone/"
# Pfad zu den Raumimpulsantwort-Dateien (WAV-Dateien von echten Räumen)
RIR_ROOT  = "d:/Dropbox/03 H2 Think/AuDroK mFund/Auswertungen/25-03 Drone Classifier/RIRs/"

# Harmonischer Vorfilter: Segmente mit sehr wenig harmonischem Anteil werden
# aus den Trainingsdaten ausgeschlossen (z.B. stille oder rauschige Segmente).
# 0.45 bedeutet: mindestens 45% der Energie muss harmonisch sein.
HARM_THRESHOLD = 0.45

# Wahrscheinlichkeiten für die einzelnen Augmentierungsschritte.
# Jeder Wert gibt an, mit welcher Wahrscheinlichkeit dieser Schritt
# auf ein gegebenes Segment angewendet wird.
P_APPLY_RIR    = 0.7   # Faltung mit Raumimpulsantwort
P_APPLY_ECHO   = 0.5   # Bodenreflexion simulieren
P_APPLY_NOISE  = 0.8   # Hintergrundgeräusch hinzumischen
P_PITCH_SHIFT  = 0.2   # Tonhöhe verschieben
P_TIME_STRETCH = 0.6   # Zeitstreckung/-stauchung

# Zufalls-Seed: Sorgt dafür, dass die Ergebnisse reproduzierbar sind.
# Mit dem gleichen Seed bekommt man bei gleichem Datensatz immer das gleiche Ergebnis.
SEED = 42

# Cache-Einstellungen:
# Vorberechnete Segmente und Spektrogramme werden in diesem Ordner gespeichert.
# Beim nächsten Start wird der Cache geladen statt alles neu zu berechnen.
# Auf False setzen, um den Cache zu umgehen und alles neu zu berechnen.
CACHE_DIR   = Path("cache")
USE_CACHE   = True


# ============================================================
# CACHE-HILFSFUNKTIONEN
# ============================================================

def _cache_key(name: str, **params) -> Path:
    """
    Erstellt einen eindeutigen Dateinamen für eine Cache-Datei.

    Der Dateiname enthält die wichtigsten Parameter als Hash, damit der
    Cache automatisch ungültig wird, wenn sich Parameter ändern —
    z.B. wenn IMG_SIZE oder HARM_THRESHOLD geändert wird.
    """
    # Parameter zu einem lesbaren String zusammenfügen
    param_str = "_".join(f"{k}{v}" for k, v in sorted(params.items()))
    # Kurzen Hash daraus bilden (erste 8 Zeichen reichen zur Unterscheidung)
    short_hash = hashlib.md5(param_str.encode()).hexdigest()[:8]
    CACHE_DIR.mkdir(exist_ok=True)
    return CACHE_DIR / f"{name}_{short_hash}.pkl"


def _save_cache(obj, path: Path) -> None:
    """Speichert ein beliebiges Python-Objekt als Pickle-Datei."""
    with open(path, "wb") as f:
        pickle.dump(obj, f)
    print(f"  Cache gespeichert: {path}")


def _load_cache(path: Path):
    """Lädt ein Python-Objekt aus einer Pickle-Datei."""
    with open(path, "rb") as f:
        return pickle.load(f)


def precompute_spectrograms(
    segments: List[np.ndarray],
    desc: str = "Spektrogramme vorberechnen",
) -> List[torch.Tensor]:
    """
    Berechnet alle Log-Mel-Spektrogramme einmalig im Voraus.

    Warum das so wichtig ist für die Trainingsgeschwindigkeit:
    Ohne Vorberechnung ruft PyTorch für JEDES Sample in JEDER Epoche
    extract_logmel() auf — das sind teure librosa-Operationen.
    Mit Vorberechnung passiert das nur EINMAL, danach lädt das Dataset
    nur noch fertige Tensoren aus dem Speicher.

    Beispiel: 3000 Segmente × 20 Epochen = 60.000 librosa-Aufrufe OHNE Cache
                                          =  3.000 librosa-Aufrufe MIT Cache
    """
    tensors = []
    for seg in tqdm(segments, desc=f"  {desc}", unit="Seg", leave=True):
        tensors.append(extract_logmel(seg))
    return tensors


# ============================================================
# REPRODUZIERBARKEIT
# ============================================================

def _set_global_seed(seed: int) -> None:
    """Setzt alle Zufalls-Seeds für Python, NumPy und PyTorch."""
    global SEED
    SEED = int(seed)
    random.seed(SEED)
    np.random.seed(SEED)
    torch.manual_seed(SEED)
    torch.cuda.manual_seed_all(SEED)
    # deterministic=True: Macht GPU-Operationen deterministisch (etwas langsamer)
    torch.backends.cudnn.deterministic = True
    torch.backends.cudnn.benchmark = False  # Kein automatisches Optimieren der Conv-Algorithmen


_set_global_seed(SEED)


def set_experiment_config(seed=None, aug_probs=None):
    """
    Erlaubt es, Seed und Augmentierungswahrscheinlichkeiten von außen zu setzen.
    Wird vom augment_sweep.py verwendet, um verschiedene Konfigurationen zu testen.
    """
    global P_APPLY_RIR, P_APPLY_ECHO, P_APPLY_NOISE, P_PITCH_SHIFT, P_TIME_STRETCH
    if seed is not None:
        _set_global_seed(seed)
    if aug_probs:
        P_APPLY_RIR    = aug_probs.get("P_APPLY_RIR",    P_APPLY_RIR)
        P_APPLY_ECHO   = aug_probs.get("P_APPLY_ECHO",   P_APPLY_ECHO)
        P_APPLY_NOISE  = aug_probs.get("P_APPLY_NOISE",  P_APPLY_NOISE)
        P_PITCH_SHIFT  = aug_probs.get("P_PITCH_SHIFT",  P_PITCH_SHIFT)
        P_TIME_STRETCH = aug_probs.get("P_TIME_STRETCH", P_TIME_STRETCH)


# ============================================================
# DEBUG: SPEKTROGRAMME ALS PNG SPEICHERN
# ============================================================

def _ensure_debug_dir(split_name: str, class_name: str) -> Path:
    """Erstellt den Ausgabeordner für Debug-Spektrogramme, falls er noch nicht existiert."""
    out_dir = Path(MFCC_DEBUG_ROOT) / split_name / class_name
    out_dir.mkdir(parents=True, exist_ok=True)
    return out_dir


def save_logmel_png(segment: np.ndarray, out_png: Path, title: str = "") -> None:
    """
    Berechnet ein Log-Mel-Spektrogramm und speichert es als PNG.
    Dient zur visuellen Kontrolle, wie die Trainingsdaten aussehen.
    """
    mel = librosa.feature.melspectrogram(
        y=segment, sr=SAMPLE_RATE, n_mels=N_MELS, hop_length=HOP_LENGTH
    )
    # power_to_db wandelt die Leistungswerte in Dezibel um (logarithmische Skala)
    log_mel = librosa.power_to_db(mel, ref=np.max).astype(np.float32)
    fig, ax = plt.subplots(figsize=(6, 4))
    ax.imshow(log_mel, aspect="auto", origin="lower", interpolation="nearest")
    ax.set_title(title if title else out_png.stem)
    ax.set_xlabel("Frames")
    ax.set_ylabel("Mel bin")
    fig.tight_layout()
    fig.savefig(out_png, dpi=150)
    plt.close(fig)


# ============================================================
# HARMONISCHER VORFILTER
# ============================================================

def compute_harmonic_ratio(signal: np.ndarray) -> float:
    """
    Berechnet den harmonischen Anteil eines Audiosignals.

    HPSS (Harmonic-Percussive Source Separation) zerlegt das Signal in:
      - harmonischen Anteil (periodische Töne, wie Drohnengeräusch)
      - perkussiven Anteil (kurze Impulse, wie Knacken oder Rauschen)

    Rückgabe: Wert zwischen 0 (rein perkussiv) und 1 (rein harmonisch).
    """
    harm, perc = librosa.effects.hpss(signal)
    harm_energy = np.sum(np.abs(harm))
    perc_energy = np.sum(np.abs(perc))
    # 1e-9 verhindert Division durch Null bei einem Stille-Segment
    return float(harm_energy / (harm_energy + perc_energy + 1e-9))


# ============================================================
# RAUMIMPULSANTWORTEN (RIRs) LADEN
# ============================================================

def load_rir_pool() -> List[np.ndarray]:
    """
    Lädt alle WAV-Dateien aus dem RIR-Ordner als Raumimpulsantworten.

    Eine Raumimpulsantwort beschreibt, wie ein Raum klingt: Wenn man sie
    mit einem Signal faltet (convolve_rir), klingt das Signal so, als wäre
    es in diesem Raum aufgenommen worden.

    Rückgabe: Liste von RIR-Arrays (normiert auf Maximalamplitude 1).
    """
    rir_files: List[np.ndarray] = []
    if not os.path.isdir(RIR_ROOT):
        print(f"  [Warnung] RIR-Ordner nicht gefunden: {RIR_ROOT}")
        return rir_files

    rir_filenames = [
        f for f in os.listdir(RIR_ROOT)
        if f.lower().endswith((".wav", ".flac", ".ogg", ".mp3"))
    ]

    for fname in tqdm(rir_filenames, desc="  RIRs laden", unit="Datei", leave=False):
        path = os.path.join(RIR_ROOT, fname)
        try:
            rir, _ = librosa.load(path, sr=SAMPLE_RATE)
            rir = rir.astype(np.float32)
            # Normierung: Spitzenwert auf 1 setzen, damit die RIR das Signal
            # nicht unbeabsichtigt laut oder leise macht
            if np.max(np.abs(rir)) > 1e-6:
                rir = rir / np.max(np.abs(rir))
            rir_files.append(rir)
        except Exception as e:
            print(f"  [Warnung] RIR konnte nicht geladen werden: {fname} ({e})")

    return rir_files


# ============================================================
# AUGMENTIERUNGSFUNKTIONEN
# ============================================================

def convolve_rir(signal: np.ndarray, rir: np.ndarray) -> np.ndarray:
    """
    Faltet ein Audiosignal mit einer Raumimpulsantwort.

    Faltung im Zeitbereich: Das Ergebnis ist länger als das Eingangssignal
    (wegen dem Nachhall). Wir schneiden es auf die Originallänge zurück.
    """
    conv = np.convolve(signal, rir, mode="full")
    # Auf Originallänge kürzen oder auffüllen
    if len(conv) >= len(signal):
        conv = conv[: len(signal)]
    else:
        conv = np.pad(conv, (0, len(signal) - len(conv)))
    return conv


def add_ground_reflection(signal: np.ndarray, delay_ms: float, amplitude: float) -> np.ndarray:
    """
    Simuliert eine Bodenreflexion: Das Signal wird mit einer kurzen Verzögerung
    und etwas abgeschwächt auf sich selbst addiert.

    delay_ms:  Verzögerung in Millisekunden (typisch 5–30 ms für Bodenreflexion)
    amplitude: Wie laut die Reflexion im Vergleich zum Original ist (0–1)
    """
    delay_samples = int((delay_ms / 1000.0) * SAMPLE_RATE)
    echo = np.zeros_like(signal)
    if delay_samples < len(signal):
        # Das Echo ist das Signal, um delay_samples nach hinten verschoben
        echo[delay_samples:] = signal[:-delay_samples]
    # Leichte Tiefpassfilterung: Reflexionen verlieren hohe Frequenzen
    # lfilter([0.7, 0.3], [1.0], ...) ist ein einfacher FIR-Tiefpassfilter
    echo = scipy.signal.lfilter([0.7, 0.3], [1.0], echo)
    return signal + amplitude * echo


def mix_noise(clean: np.ndarray, noise: np.ndarray, snr_db: float) -> np.ndarray:
    """
    Mischt ein Hintergrundgeräusch zum sauberen Signal bei einem bestimmten SNR.

    SNR (Signal-to-Noise Ratio) in Dezibel:
      - 25 dB = Drohne klar hörbar, wenig Rauschen
      -  3 dB = Drohne kaum hörbar, viel Rauschen

    Das Rauschsignal wird so skaliert, dass das gewünschte SNR erreicht wird.
    """
    # Rauschsignal auf die Länge des Nutzsignals bringen (ggf. wiederholen)
    if len(noise) < len(clean):
        repeats = int(np.ceil(len(clean) / len(noise)))
        noise = np.tile(noise, repeats)
    noise = noise[: len(clean)]

    sig_power   = np.mean(clean ** 2)           # Leistung des Nutzsignals
    noise_power = np.mean(noise ** 2)           # Leistung des Rauschens
    # Gewünschte Rauschleistung aus dem SNR berechnen
    target_noise_power = sig_power / (10 ** (snr_db / 10))
    # Rauschen so skalieren, dass es die gewünschte Leistung hat
    noise_scaled = noise * np.sqrt(target_noise_power / (noise_power + 1e-9))
    return clean + noise_scaled


def pitch_shift(signal: np.ndarray, steps: float) -> np.ndarray:
    """
    Verschiebt die Tonhöhe des Signals um 'steps' Halbtöne.
    Positive Werte = höher, negative Werte = tiefer.
    Typisch: ±2 Halbtöne, was einer Tempoänderung der Rotoren entspricht.
    """
    shifted = librosa.effects.pitch_shift(signal, sr=SAMPLE_RATE, n_steps=steps)
    # Auf exakt SEG_LEN kürzen oder auffüllen (librosa kann Länge leicht verändern)
    if len(shifted) > len(signal):
        shifted = shifted[: len(signal)]
    elif len(shifted) < len(signal):
        shifted = np.pad(shifted, (0, len(signal) - len(shifted)))
    return shifted.astype(signal.dtype)


def time_stretch(signal: np.ndarray, rate: float) -> np.ndarray:
    """
    Streckt oder staucht das Signal zeitlich um den Faktor 'rate'.
    rate > 1.0 = schneller (kürzer), rate < 1.0 = langsamer (länger).
    Typisch: 0.9–1.1 (±10%), simuliert unterschiedliche Drohnengeschwindigkeiten.
    """
    stretched = librosa.effects.time_stretch(signal, rate=rate)
    if len(stretched) > len(signal):
        stretched = stretched[: len(signal)]
    else:
        stretched = np.pad(stretched, (0, len(signal) - len(stretched)))
    return stretched.astype(signal.dtype)


def load_noise_pool(no_folder: str) -> List[np.ndarray]:
    """
    Lädt alle Audio-Dateien aus dem 'no drone'-Ordner und zerlegt sie
    in 1-Sekunden-Segmente mit 50% Überlappung.

    Diese Segmente dienen als Hintergrundgeräusche, die beim Augmentieren
    zu den Drohnen-Segmenten hinzugemischt werden.
    """
    pool: List[np.ndarray] = []
    filenames = [f for f in os.listdir(no_folder)
                 if os.path.isfile(os.path.join(no_folder, f))]

    for fname in tqdm(filenames, desc="  Noise-Pool laden", unit="Datei", leave=False):
        path = os.path.join(no_folder, fname)
        try:
            y, _ = librosa.load(path, sr=SAMPLE_RATE)
        except Exception:
            continue
        hop = SEG_LEN // 2  # 50% Überlappung = mehr Segmente aus derselben Datei
        for i in range(0, len(y) - SEG_LEN + 1, hop):
            seg = y[i : i + SEG_LEN]
            if len(seg) == SEG_LEN:
                pool.append(seg)

    return pool


def augment_signal(
    signal: np.ndarray,
    noise_pool: List[np.ndarray],
    rir_pool: List[np.ndarray],
) -> np.ndarray:
    """
    Wendet eine zufällige Kombination von Augmentierungsschritten an.

    Jeder Schritt wird nur mit einer bestimmten Wahrscheinlichkeit angewendet
    (die globalen P_*-Variablen). So bekommt jede augmentierte Kopie eine
    andere Kombination von Augmentierungen.

    Reihenfolge: RIR → Echo → Noise → Pitch → TimeStretch → Normierung
    """
    aug = signal.copy()

    # 1. Raumimpulsantwort falten (Drohne klingt wie in einem Raum)
    if rir_pool and random.random() < P_APPLY_RIR:
        rir = random.choice(rir_pool)
        aug = convolve_rir(aug, rir)

    # 2. Bodenreflexion simulieren (kurzes Echo von unten)
    if random.random() < P_APPLY_ECHO:
        delay = random.randint(5, 30)           # 5–30 ms Verzögerung
        amp   = random.uniform(0.02, 0.08)     # 2–8% Amplitude
        aug = add_ground_reflection(aug, delay_ms=delay, amplitude=amp)

    # 3. Hintergrundgeräusch hinzumischen
    if noise_pool and random.random() < P_APPLY_NOISE:
        noise_seg = random.choice(noise_pool)
        # 0–20 dB: verschiebt das Training zu schwerer hörbaren Drohnen.
        # 0 dB = Drohne und Rauschen gleich laut; 20 dB = Drohne klar hörbar.
        snr = random.uniform(0, 20)
        aug = mix_noise(aug, noise_seg, snr_db=snr)

    # 4. Tonhöhe verschieben (±2 Halbtöne)
    if random.random() < P_PITCH_SHIFT:
        steps = random.uniform(-2, 2)
        aug = pitch_shift(aug, steps)

    # 5. Zeitstreckung (±10%)
    if random.random() < P_TIME_STRETCH:
        rate = random.uniform(0.9, 1.1)
        aug = time_stretch(aug, rate)

    # 6. Normierung: Spitzenwert auf 1 setzen, damit das Netz konsistente
    #    Amplituden bekommt (verhindert zu laute oder zu leise Segmente)
    max_abs = np.max(np.abs(aug))
    if max_abs > 1e-3:
        aug = aug / max_abs

    return aug


# ============================================================
# SEGMENTE LADEN
# ============================================================

def load_segments(
    folder: str,
    label: int,
    pre_classify: bool,
    noise_pool: List[np.ndarray],
    rir_pool: List[np.ndarray],
    augment: bool = False,
    num_augment: int = 1,
    split_name: str = None,
    class_name: str = None,
    save_mfcc_pngs: bool = False,
) -> Tuple[List[np.ndarray], List[int]]:
    """
    Lädt alle Audio-Dateien aus 'folder', zerlegt sie in 1-Sekunden-Segmente
    und gibt Segmente + Labels zurück.

    label:          1 = Drohne, 0 = kein Drohne
    pre_classify:   Wenn True, werden Drohnen-Segmente mit niedrigem harmonischem
                    Anteil herausgefiltert (nur für Trainingsdaten sinnvoll)
    augment:        Ob augmentierte Kopien erstellt werden sollen
    num_augment:    Wie viele augmentierte Kopien pro Original-Segment
    """
    segments: List[np.ndarray] = []
    labels:   List[int]        = []

    # Nur Audio-Dateien berücksichtigen
    audio_files = [
        f for f in os.listdir(folder)
        if f.lower().endswith((".wav", ".flac", ".ogg", ".mp3"))
    ]

    desc = f"  {split_name or ''} {class_name or ''} laden".strip()
    for fname in tqdm(audio_files, desc=desc, unit="Datei", leave=False):
        path = os.path.join(folder, fname)
        try:
            y, _ = librosa.load(path, sr=SAMPLE_RATE)
        except Exception as e:
            print(f"  [Warnung] Datei übersprungen: {fname} ({e})")
            continue

        stem    = Path(fname).stem
        seg_idx = 0

        # Datei in nicht-überlappende SEG_LEN-Chunks zerlegen
        for i in range(0, len(y) - SEG_LEN + 1, SEG_LEN):
            seg = y[i : i + SEG_LEN]
            if len(seg) < SEG_LEN:
                continue
            seg_idx += 1

            # Harmonischer Vorfilter: nur für Drohnen-Trainingssegmente
            if label == 1 and pre_classify:
                ratio = compute_harmonic_ratio(seg)
                if ratio < HARM_THRESHOLD:
                    continue  # Segment verwerfen, zu wenig Drohnen-Charakter

            # Optional: Spektrogramm als PNG für visuelle Kontrolle speichern
            if save_mfcc_pngs and split_name is not None and class_name is not None:
                out_dir = _ensure_debug_dir(split_name, class_name)
                out_png = out_dir / f"{stem}_{seg_idx:04d}.png"
                save_logmel_png(seg, out_png, title=f"{stem}_{seg_idx:04d}")

            # Original-Segment hinzufügen
            segments.append(seg)
            labels.append(label)

            # Augmentierte Kopien hinzufügen (nur für Drohnen-Trainings-Segmente)
            if label == 1 and augment:
                for _ in range(num_augment):
                    aug = augment_signal(seg, noise_pool, rir_pool)
                    segments.append(aug)
                    labels.append(label)

    return segments, labels


# ============================================================
# FEATURE-EXTRAKTION: LOG-MEL-SPEKTROGRAMM
# ============================================================

def extract_logmel(segment: np.ndarray) -> torch.Tensor:
    """
    Wandelt ein 1-Sekunden-Audiosegment in ein Bild für MobileNetV3 um.

    Schritte:
      1. Mel-Spektrogramm berechnen (Frequenz-Zeit-Darstellung)
      2. Logarithmieren (dB-Skala, näher an menschlicher Wahrnehmung)
      3. Auf [0, 1] normieren
      4. Als 3-Kanal-Tensor (wie RGB-Bild) aufbereiten
      5. Auf 224×224 skalieren (MobileNetV3-Eingabegröße)
      6. ImageNet-Normierung anwenden (weil das Netz darauf vortrainiert wurde)
    """
    # Mel-Spektrogramm: Amplitude² über Frequenzbänder und Zeit
    mel = librosa.feature.melspectrogram(
        y=segment, sr=SAMPLE_RATE, n_mels=N_MELS, hop_length=HOP_LENGTH
    )
    # Dezibel-Umrechnung: macht das Spektrogramm visuell lesbarer
    log_mel = librosa.power_to_db(mel, ref=np.max).astype(np.float32)

    # Normierung auf [0, 1]: Subtraktion des Minimums, Division durch Wertebereich
    x = log_mel
    x = (x - x.min()) / (x.max() - x.min() + 1e-8)

    # NumPy-Array → PyTorch-Tensor, Dimension hinzufügen: [H, W] → [1, H, W]
    x = torch.from_numpy(x).unsqueeze(0)

    # 3 Kanäle durch Wiederholung: [1, H, W] → [3, H, W]
    # MobileNetV3 erwartet 3-Kanal-Eingabe (wie ein RGB-Bild)
    x = x.repeat(3, 1, 1)

    # Auf 224×224 interpolieren (bilinear = glatte Skalierung)
    x = F.interpolate(
        x.unsqueeze(0), size=(IMG_SIZE, IMG_SIZE), mode="bilinear", align_corners=False
    ).squeeze(0)

    # ImageNet-Normierung: (Pixel - Mittelwert) / Standardabweichung, pro Kanal
    x = (x - IMAGENET_MEAN) / IMAGENET_STD

    return x  # Form: [3, 224, 224]


# ============================================================
# SPECAUGMENT: ONLINE-AUGMENTIERUNG IM SPEKTROGRAMM
# ============================================================

def spec_augment(
    x: torch.Tensor,
    freq_mask_param: int = 20,
    time_mask_param: int = 20,
    num_freq_masks: int = 2,
    num_time_masks: int = 2,
) -> torch.Tensor:
    """
    SpecAugment: Maskiert zufällige Frequenz- und Zeitbereiche im Spektrogramm.

    Idee: Das Netz soll lernen, Drohnen auch dann zu erkennen, wenn Teile
    des Spektrogramms fehlen oder verdeckt sind (z.B. durch Windgeräusche
    die bestimmte Frequenzen überdecken).

    freq_mask_param: Maximale Breite der Frequenzmaske (in Mel-Bändern)
    time_mask_param: Maximale Breite der Zeitmaske (in Frames)
    """
    x = x.clone()  # Nicht das Original verändern
    _, H, W = x.shape
    fill_value = x.mean().item()  # Masken werden mit dem Mittelwert gefüllt

    for _ in range(num_freq_masks):
        f  = random.randint(0, freq_mask_param)          # Breite der Maske
        f0 = random.randint(0, max(H - f, 0))            # Startposition
        x[:, f0 : f0 + f, :] = fill_value               # Frequenzzeilen maskieren

    for _ in range(num_time_masks):
        t  = random.randint(0, time_mask_param)
        t0 = random.randint(0, max(W - t, 0))
        x[:, :, t0 : t0 + t] = fill_value               # Zeitspalten maskieren

    return x


# ============================================================
# PYTORCH DATASET
# ============================================================

class DroneDataset(Dataset):
    """
    PyTorch Dataset: Verwaltet vorberechnete Spektrogramm-Tensoren und Labels.

    Im Gegensatz zur früheren Version speichert dieses Dataset keine Roh-Audio-
    Segmente mehr, sondern fertige Tensoren (bereits als Log-Mel-Spektrogramm
    berechnet). Das macht jeden Datenzugriff im Training sehr schnell:
    Statt teurer librosa-Operationen findet nur noch ein einfacher Array-Zugriff statt.

    augment=True:  SpecAugment (Frequenz-/Zeitmaskierung) wird online angewendet.
                   Nur für Trainingsdaten — Validierung ohne Augmentierung.
    """

    def __init__(self, spec_tensors: List[torch.Tensor], labels: List[int], augment: bool = False):
        self.specs   = spec_tensors  # Vorberechnete [3, IMG_SIZE, IMG_SIZE] Tensoren
        self.labels  = labels
        self.augment = augment

    def __len__(self) -> int:
        return len(self.specs)

    def __getitem__(self, idx: int):
        x = self.specs[idx]
        # Online-Augmentierung: zufällige Maskierung im Spektrogramm
        if self.augment:
            x = spec_augment(x)
        y = self.labels[idx]
        return x, y


# ============================================================
# MODELL: MOBILENETV3-SMALL MIT TRANSFER LEARNING
# ============================================================

class DroneClassifier(nn.Module):
    """
    MobileNetV3-Small als Basis-Netz, mit angepasstem Klassifikationskopf.

    Transfer Learning: Das Netz wurde auf ImageNet (1.2 Mio. Fotos, 1000 Klassen)
    vortrainiert. Es hat dabei gelernt, allgemeine visuelle Muster zu erkennen
    (Kanten, Texturen, Formen). Diese Fähigkeit übertragen wir auf Spektrogramme.

    Wir ersetzen nur den letzten Teil (den "Kopf") für unsere 2-Klassen-Aufgabe.
    """

    def __init__(self):
        super().__init__()
        # Vortrainiertes Modell laden (lädt Gewichte automatisch herunter)
        weights = MobileNet_V3_Small_Weights.DEFAULT
        self.backbone = mobilenet_v3_small(weights=weights)

        # Originalen Klassifikationskopf (für 1000 ImageNet-Klassen) ersetzen
        # durch einen neuen Kopf für 2 Klassen (Drohne / keine Drohne)
        in_features = self.backbone.classifier[0].in_features
        self.backbone.classifier = nn.Sequential(
            nn.Linear(in_features, 256),  # Vollverbundene Schicht: in_features → 256
            nn.Hardswish(),               # Aktivierungsfunktion (glatte ReLU-Variante)
            nn.Dropout(p=0.2, inplace=True),  # Dropout: 20% der Neuronen werden zufällig
                                               # deaktiviert → reduziert Überanpassung
            nn.Linear(256, 1),            # Ausgabe: ein Wert (Logit für "Drohne")
        )

    def forward(self, x: torch.Tensor) -> torch.Tensor:
        """Vorwärtsdurchlauf: Eingabe → Logit (kein Sigmoid hier, das macht BCEWithLogitsLoss)"""
        x = self.backbone(x)
        return x.squeeze(-1)  # [batch, 1] → [batch]


# ============================================================
# HILFSFUNKTIONEN ZUM EIN-/AUSFRIEREN VON SCHICHTEN
# ============================================================

def freeze_backbone(model: DroneClassifier) -> None:
    """
    Friert alle Feature-Extraktions-Schichten ein (keine Gewichtsänderung).
    Nur der Klassifikationskopf wird trainiert.

    Warum: In Phase 1 wollen wir nur den neuen Kopf anpassen, bevor wir
    das gesamte Netz feinjustieren. Sonst würden die vortrainierten Gewichte
    zu schnell zerstört.
    """
    for param in model.backbone.features.parameters():
        param.requires_grad = False
    for param in model.backbone.classifier.parameters():
        param.requires_grad = True


def unfreeze_last_blocks(model: DroneClassifier, num_blocks: int = 4) -> None:
    """
    Gibt die letzten 'num_blocks' Feature-Blöcke zum Training frei.

    In Phase 2 (Fine-Tuning) erlauben wir dem Netz, die letzten
    MobileNet-Blöcke an unsere Domäne (Spektrogramme) anzupassen.
    Die frühen Blöcke (einfache Kanten/Texturen) bleiben eingefroren.
    """
    # Erst alles einfrieren
    for param in model.backbone.features.parameters():
        param.requires_grad = False
    # Dann die letzten num_blocks Blöcke freigeben
    for block in list(model.backbone.features.children())[-num_blocks:]:
        for param in block.parameters():
            param.requires_grad = True
    # Klassifikationskopf bleibt immer trainierbar
    for param in model.backbone.classifier.parameters():
        param.requires_grad = True


# ============================================================
# EVALUATION: MODELL AUF VALIDIERUNGSDATEN TESTEN
# ============================================================

def evaluate_loader(
    model: nn.Module,
    loader: DataLoader,
    device: torch.device,
    desc: str = "  Auswerten",
) -> Tuple[np.ndarray, np.ndarray]:
    """
    Lässt das Modell alle Batches eines DataLoaders durchlaufen und
    sammelt wahre Labels und vorhergesagte Wahrscheinlichkeiten.

    Rückgabe:
      labels: Array mit echten Labels (0 oder 1)
      probs:  Array mit vorhergesagten Drohnen-Wahrscheinlichkeiten (0.0–1.0)
    """
    model.eval()  # Dropout und BatchNorm auf Evaluierungsmodus schalten
    all_labels: List[int]   = []
    all_probs:  List[float] = []

    with torch.no_grad():  # Keine Gradienten berechnen (spart Speicher und Zeit)
        for X_batch, y_batch in tqdm(loader, desc=desc, unit="Batch", leave=False):
            X_batch = X_batch.to(device)
            logits  = model(X_batch)
            # Sigmoid wandelt den Logit in eine Wahrscheinlichkeit [0, 1] um
            probs = torch.sigmoid(logits).cpu().numpy()
            all_probs.extend(probs.tolist())
            all_labels.extend(y_batch.numpy().tolist())

    return np.array(all_labels), np.array(all_probs)


# ============================================================
# PLOTS: KONFUSIONSMATRIX UND WAHRSCHEINLICHKEITSVERTEILUNG
# ============================================================

def plot_confusion(labels: np.ndarray, probs: np.ndarray, suffix: str,
                   threshold: float = 0.5) -> str:
    """
    Erstellt eine Konfusionsmatrix und speichert sie als PNG.

    Die Konfusionsmatrix zeigt:
      - Zeilen: Echte Klasse (Drohne / keine Drohne)
      - Spalten: Vorhergesagte Klasse
      - Werte: Absolute Anzahl + prozentualer Anteil

    threshold: Schwellenwert für die Entscheidung (Standard 0.5).
               Niedrigere Werte → mehr Drohnen erkannt, mehr Fehlalarme.
    """
    preds = (probs >= threshold).astype(int)
    cm = confusion_matrix(labels, preds, labels=[1, 0])
    # Normieren: Jede Zeile auf 100% (relative Erkennungsrate pro echter Klasse)
    cm_percent = cm.astype(float) / cm.sum(axis=1, keepdims=True)

    classes = ["Drone", "No Drone"]
    fig, ax = plt.subplots()
    ax.imshow(cm_percent, interpolation="nearest", cmap="Blues")
    ax.set_xticks([0, 1]);  ax.set_xticklabels(classes)
    ax.set_yticks([0, 1]);  ax.set_yticklabels(classes)
    ax.set_xlabel("Vorhergesagt")
    ax.set_ylabel("Echt")
    ax.set_title(f"Konfusionsmatrix ({suffix}, T={threshold:.2f})")

    for i in range(2):
        for j in range(2):
            count = cm[i, j]
            perc  = cm_percent[i, j] * 100.0
            ax.text(j, i, f"{count}\n({perc:.1f}%)", ha="center", va="center",
                    color="white" if cm_percent[i, j] > 0.5 else "black")

    fig.tight_layout()
    filename = f"confusion_matrix_{suffix}.png"
    fig.savefig(filename)
    plt.close(fig)
    print(f"  Konfusionsmatrix gespeichert: {filename}")
    return filename


def plot_probability_distribution(labels: np.ndarray, probs: np.ndarray, suffix: str) -> str:
    """
    Histogramm der vorhergesagten Wahrscheinlichkeiten, getrennt nach Klasse.

    Ideales Ergebnis:
      - Drohnen-Kurve: Gipfel nahe bei 1.0
      - No-Drone-Kurve: Gipfel nahe bei 0.0
      - Klare Trennung der beiden Verteilungen

    Wenn beide Kurven ähnlich aussehen, hat das Modell die Klassen nicht
    gut gelernt.
    """
    drone_probs = probs[labels == 1]
    no_probs    = probs[labels == 0]
    bins = np.linspace(0.0, 1.0, 40)

    fig, ax = plt.subplots()
    ax.hist(drone_probs, bins=bins, alpha=0.6, label="Drohne",     density=True)
    ax.hist(no_probs,    bins=bins, alpha=0.6, label="Keine Drohne", density=True)
    ax.set_xlabel("Vorhergesagte Wahrscheinlichkeit für 'Drohne'")
    ax.set_ylabel("Dichte")
    ax.set_title(f"Wahrscheinlichkeitsverteilung ({suffix})")
    ax.legend()
    fig.tight_layout()

    filename = f"probability_distribution_{suffix}.png"
    fig.savefig(filename)
    plt.close(fig)
    print(f"  Wahrscheinlichkeitsverteilung gespeichert: {filename}")
    return filename


# ============================================================
# MODELL-EXPORT
# ============================================================

def export_to_tflite(
    model: nn.Module,
    device: torch.device,
    input_shape: Tuple[int, int, int, int],
    filename: str = "model.tflite",
) -> None:
    """
    Exportiert das PyTorch-Modell ins TFLite-Format (für Mobilgeräte).

    Weg: PyTorch → ONNX → TensorFlow → TFLite
    Schlägt fehl, wenn onnx-tf oder TensorFlow nicht installiert sind —
    das ONNX-Modell wird aber trotzdem gespeichert.
    """
    print("  Exportiere Modell nach ONNX ...")
    dummy_input = torch.randn(*input_shape, device=device)
    onnx_path = "model.onnx"
    try:
        torch.onnx.export(
            model, dummy_input, onnx_path,
            input_names=["input"], output_names=["output"],
            dynamic_axes={"input": {0: "batch"}, "output": {0: "batch"}},
            opset_version=11,
        )
        print(f"  ONNX-Modell gespeichert: {onnx_path}")
    except Exception as e:
        print(f"  [Fehler] ONNX-Export fehlgeschlagen: {e}")
        return

    print("  Versuche Konvertierung nach TFLite ...")
    try:
        import onnx
        from onnx_tf.backend import prepare
        import tensorflow as tf
        onnx_model  = onnx.load(onnx_path)
        tf_rep      = prepare(onnx_model)
        concrete    = tf_rep.export_graph()
        converter   = tf.lite.TFLiteConverter.from_concrete_functions([concrete])
        tflite_model = converter.convert()
        with open(filename, "wb") as f:
            f.write(tflite_model)
        print(f"  TFLite-Modell gespeichert: {filename}")
    except Exception as e:
        print(f"  [Info] TFLite-Konvertierung nicht möglich: {e}")
        print("  (ONNX-Modell ist aber verfügbar.)")


# ============================================================
# MIXUP: SPEKTROGRAMME MISCHEN
# ============================================================

def mixup_batch(
    X: torch.Tensor,
    y: torch.Tensor,
    alpha: float = 0.3,
) -> Tuple[torch.Tensor, torch.Tensor]:
    """
    Mixup-Augmentierung auf Batch-Ebene.

    Idee: Zwei zufällig gewählte Samples werden linear gemischt:
      x_mix = λ * x_a + (1-λ) * x_b
      y_mix = λ * y_a + (1-λ) * y_b

    Das erzeugt "Zwischenfälle": ein halb-Drohnen-halb-Kein-Drohnen-
    Spektrogramm mit Label 0.5. Das Modell lernt dadurch bessere
    Entscheidungsgrenzen statt harte Übergänge auswendig zu lernen.

    alpha: Steuert, wie stark gemischt wird. Niedrig (0.2–0.4) = nur
    leichte Mischung, hoch (0.5+) = starke Mischung.
    """
    # λ aus einer Beta-Verteilung ziehen: bei alpha=0.3 meistens nahe 0 oder 1,
    # also nur gelegentlich wirklich stark gemischt
    lam = float(np.random.beta(alpha, alpha))
    # Zufällige Permutation der Batch-Indizes (jedes Sample bekommt einen Mischpartner)
    batch_size = X.size(0)
    perm = torch.randperm(batch_size, device=X.device)
    # Mischen
    X_mix = lam * X + (1.0 - lam) * X[perm]
    y_mix = lam * y + (1.0 - lam) * y[perm]
    return X_mix, y_mix


# ============================================================
# THRESHOLD-OPTIMIERUNG
# ============================================================

def find_optimal_threshold(
    labels: np.ndarray,
    probs: np.ndarray,
    min_precision: float = 0.90,
) -> Tuple[float, float, float, float]:
    """
    Sucht den optimalen Entscheidungs-Threshold auf dem Validierungsset.

    Strategie:
      1. F1-Threshold: maximiert den F1-Score (ausgewogen zwischen Recall und Precision)
      2. Recall-Threshold: maximiert Recall unter der Bedingung, dass
         Precision >= min_precision bleibt (keine strukturellen Fehlalarme)

    Beide Werte werden zurückgegeben und als Plot gespeichert.

    min_precision: Untergrenze für Precision beim Recall-optimierten Threshold.
    """
    from sklearn.metrics import precision_recall_curve, f1_score

    # Precision und Recall für alle möglichen Schwellenwerte berechnen
    # precision_recall_curve gibt Werte für viele Thresholds zurück
    precisions, recalls, thresholds = precision_recall_curve(labels, probs)
    # Hinweis: len(thresholds) = len(precisions) - 1, letzter Eintrag ist Dummy
    precisions = precisions[:-1]
    recalls    = recalls[:-1]

    # F1 für jeden Threshold
    f1_scores = 2 * precisions * recalls / (precisions + recalls + 1e-9)

    # Threshold mit maximalem F1
    best_f1_idx  = int(np.argmax(f1_scores))
    best_f1_thresh = float(thresholds[best_f1_idx])
    best_f1        = float(f1_scores[best_f1_idx])

    # Threshold mit maximalem Recall bei Precision >= min_precision
    valid_mask = precisions >= min_precision
    if valid_mask.any():
        # Unter allen gültigen Thresholds: den mit höchstem Recall
        best_recall_idx    = int(np.argmax(recalls * valid_mask))
        best_recall_thresh = float(thresholds[best_recall_idx])
        best_recall        = float(recalls[best_recall_idx])
        best_recall_prec   = float(precisions[best_recall_idx])
    else:
        # Fallback: F1-Threshold verwenden
        best_recall_thresh = best_f1_thresh
        best_recall        = float(recalls[best_f1_idx])
        best_recall_prec   = float(precisions[best_f1_idx])

    # Precision-Recall-Kurve als Plot speichern
    fig, ax = plt.subplots(figsize=(7, 5))
    ax.plot(recalls, precisions, color="steelblue", linewidth=2, label="PR-Kurve")
    # F1-Threshold markieren
    ax.scatter(
        recalls[best_f1_idx], precisions[best_f1_idx],
        color="green", zorder=5, s=80,
        label=f"Bester F1 (T={best_f1_thresh:.2f}, F1={best_f1:.3f})",
    )
    # Recall-Threshold markieren
    ax.scatter(
        best_recall, best_recall_prec,
        color="orange", zorder=5, s=80, marker="D",
        label=f"Max Recall bei Prec≥{min_precision:.0%} (T={best_recall_thresh:.2f})",
    )
    # Horizontale Linie bei min_precision
    ax.axhline(min_precision, color="red", linestyle="--", alpha=0.5,
               label=f"Min. Precision = {min_precision:.0%}")
    ax.set_xlabel("Recall (Drohnen-Erkennungsrate)")
    ax.set_ylabel("Precision (Genauigkeit der Alarme)")
    ax.set_title("Precision-Recall-Kurve (Validierungsset)")
    ax.legend(loc="lower left", fontsize=8)
    ax.set_xlim([0, 1]); ax.set_ylim([0, 1.02])
    ax.grid(alpha=0.3)
    fig.tight_layout()
    fig.savefig("precision_recall_curve.png")
    plt.close(fig)
    print("  PR-Kurve gespeichert: precision_recall_curve.png")

    return best_f1_thresh, best_f1, best_recall_thresh, best_recall


# ============================================================
# HAUPTFUNKTION: TRAINING
# ============================================================

def train_model(return_outputs=False):
    """
    Führt den kompletten Training-Workflow durch:
      1. Daten laden und augmentieren
      2. DataLoader aufbauen
      3. Modell initialisieren
      4. Phase 1: Nur Klassifikationskopf trainieren
      5. Phase 2: Letzten Feature-Blöcke feinjustieren
      6. Bestes Modell laden und evaluieren
      7. Plots speichern und Modell exportieren
    """

    # ----------------------------------------------------------
    # SCHRITT 1: HILFSDATEN LADEN (RIRs und Noise-Pool)
    # Diese werden nur für die Augmentierung benötigt und sind schnell zu laden.
    # ----------------------------------------------------------
    print("\n[1/7] Lade Raumimpulsantworten (RIRs) ...")
    rir_pool = load_rir_pool()
    print(f"      {len(rir_pool)} RIRs geladen.")

    print("\n[2/7] Lade Hintergrundgeräusche (Noise-Pool) ...")
    noise_pool = load_noise_pool(os.path.join(DATA_ROOT, "TRAINING", "no drone"))
    print(f"      {len(noise_pool)} Noise-Segmente geladen.")

    # ----------------------------------------------------------
    # SCHRITT 2 & 3: SEGMENTE LADEN (mit Cache)
    #
    # Das Laden + Augmentieren der Audiodateien dauert sehr lang (Stunden).
    # Deshalb speichern wir das Ergebnis als Cache-Datei auf der Festplatte.
    # Beim nächsten Start wird die Cache-Datei geladen (Sekunden statt Stunden).
    #
    # Der Cache wird automatisch neu erstellt, wenn sich wichtige Parameter
    # ändern (HARM_THRESHOLD, num_augment, SEG_LEN_SEC, SEED).
    # Um den Cache manuell zu löschen, einfach den "cache/"-Ordner löschen.
    # ----------------------------------------------------------
    # Cache-Key enthält alle Parameter, die die Segmente oder Spektrogramme beeinflussen.
    # Trainingsparameter (LR, Epochen, Batch-Size) sind bewusst NICHT enthalten —
    # sie beeinflussen die Daten nicht, nur das Training.
    seg_cache_params = dict(
        harm=HARM_THRESHOLD, seg=SEG_LEN_SEC, seed=SEED, sr=SAMPLE_RATE,
        naug=8,  # num_augment — muss mit dem Wert im load_segments-Aufruf übereinstimmen
        rir=round(P_APPLY_RIR, 3), echo=round(P_APPLY_ECHO, 3),
        noise=round(P_APPLY_NOISE, 3), pitch=round(P_PITCH_SHIFT, 3),
        stretch=round(P_TIME_STRETCH, 3),
    )
    seg_cache_path = _cache_key("segments", **seg_cache_params)

    if USE_CACHE and seg_cache_path.exists():
        print(f"\n[3/7] Lade Segmente aus Cache: {seg_cache_path} ...")
        train_segs, train_labels, val_segs, val_labels = _load_cache(seg_cache_path)
        print(f"      Cache geladen.")
    else:
        print("\n[3/7] Lade und augmentiere Trainingsdaten (einmalig, wird gecacht) ...")
        print("  Drohnen-Segmente (mit Harmonik-Filter + 4× Augmentierung) ...")
        train_drone_segs, train_drone_labels = load_segments(
            os.path.join(DATA_ROOT, "TRAINING", "drone"),
            label=1,
            pre_classify=True,
            noise_pool=noise_pool,
            rir_pool=rir_pool,
            augment=True,
            num_augment=8,  # 8 augmentierte Kopien pro Original-Segment
            split_name="Training", class_name="Drone",
            save_mfcc_pngs=False,
        )
        print(f"  → {len(train_drone_segs)} Drohnen-Segmente (inkl. Augmentierungen)")

        print("  No-Drone-Segmente (ohne Augmentierung) ...")
        train_no_segs, train_no_labels = load_segments(
            os.path.join(DATA_ROOT, "TRAINING", "no drone"),
            label=0,
            pre_classify=False,
            noise_pool=None, rir_pool=None, augment=False,
            split_name="Training", class_name="No Drone",
            save_mfcc_pngs=SAVE_MFCC_PNGS,
        )
        print(f"  → {len(train_no_segs)} No-Drone-Segmente")

        # Trainingsset mischen
        combined = list(zip(train_drone_segs + train_no_segs,
                            train_drone_labels + train_no_labels))
        random.shuffle(combined)
        train_segs, train_labels = zip(*combined)
        train_segs, train_labels = list(train_segs), list(train_labels)

        print("\n[4/7] Lade Validierungsdaten ...")
        print("  Drohnen-Segmente (ALLE, kein Harmonik-Filter) ...")
        val_drone_segs, val_drone_labels = load_segments(
            os.path.join(DATA_ROOT, "VALIDATION", "drone"),
            label=1,
            pre_classify=False,
            noise_pool=None, rir_pool=None, augment=False,
            split_name="Validation", class_name="Drone",
            save_mfcc_pngs=SAVE_MFCC_PNGS,
        )
        print(f"  → {len(val_drone_segs)} Drohnen-Segmente")

        print("  No-Drone-Segmente ...")
        val_no_segs, val_no_labels = load_segments(
            os.path.join(DATA_ROOT, "VALIDATION", "no drone"),
            label=0,
            pre_classify=False,
            noise_pool=None, rir_pool=None, augment=False,
            split_name="Validation", class_name="No Drone",
            save_mfcc_pngs=SAVE_MFCC_PNGS,
        )
        print(f"  → {len(val_no_segs)} No-Drone-Segmente")

        val_segs   = val_drone_segs + val_no_segs
        val_labels = val_drone_labels + val_no_labels

        # Cache speichern
        _save_cache((train_segs, train_labels, val_segs, val_labels), seg_cache_path)

    print(f"\n  Trainingsset:    {sum(train_labels)} Drohne / "
          f"{len(train_labels) - sum(train_labels)} Keine Drohne")
    print(f"  Validierungsset: {sum(val_labels)} Drohne / "
          f"{len(val_labels) - sum(val_labels)} Keine Drohne")

    # ----------------------------------------------------------
    # SCHRITT 4: SPEKTROGRAMME VORBERECHNEN (mit Cache)
    #
    # Die Log-Mel-Spektrogramme werden einmalig aus den Roh-Segmenten
    # berechnet und als Tensoren gespeichert. Das Dataset lädt dann beim
    # Training nur noch fertige Tensoren — kein librosa mehr pro Epoche.
    # ----------------------------------------------------------
    spec_cache_params = dict(**seg_cache_params, img=IMG_SIZE, nmels=N_MELS, hop=HOP_LENGTH)
    train_spec_cache = _cache_key("train_specs", **spec_cache_params)
    val_spec_cache   = _cache_key("val_specs",   **spec_cache_params)

    if USE_CACHE and train_spec_cache.exists() and val_spec_cache.exists():
        print(f"\n[5/7] Lade vorberechnete Spektrogramme aus Cache ...")
        train_specs = _load_cache(train_spec_cache)
        val_specs   = _load_cache(val_spec_cache)
        print(f"      {len(train_specs)} Training- und {len(val_specs)} Val-Tensoren geladen.")
    else:
        print("\n[5/7] Berechne Spektrogramme vor (einmalig, wird gecacht) ...")
        train_specs = precompute_spectrograms(train_segs, desc="Training-Spektrogramme")
        val_specs   = precompute_spectrograms(val_segs,   desc="Val-Spektrogramme")
        _save_cache(train_specs, train_spec_cache)
        _save_cache(val_specs,   val_spec_cache)
        print(f"      {len(train_specs)} Spektrogramme berechnet und gespeichert.")

    # ----------------------------------------------------------
    # SCHRITT 5: DATALOADERS AUFBAUEN
    # ----------------------------------------------------------
    print("\n[5/7] Baue DataLoader auf ...")

    # Trainings-Dataset mit SpecAugment (auf vorberechneten Tensoren)
    train_dataset = DroneDataset(train_specs, list(train_labels), augment=True)

    # WeightedRandomSampler: gleicht Klassenungleichgewichte aus,
    # indem er häufig unterrepräsentierte Klassen zieht.
    train_labels_np = np.array(train_labels)
    class_counts    = np.bincount(train_labels_np)          # [#no-drone, #drone]
    class_weights   = 1.0 / np.maximum(class_counts, 1)    # Inverse Häufigkeit
    sample_weights  = torch.DoubleTensor(class_weights[train_labels_np])
    sampler = WeightedRandomSampler(
        weights=sample_weights, num_samples=len(sample_weights), replacement=True
    )

    val_dataset = DroneDataset(val_specs, list(val_labels), augment=False)

    train_loader = DataLoader(train_dataset, batch_size=16, sampler=sampler, num_workers=0)
    val_loader   = DataLoader(val_dataset,   batch_size=16, shuffle=False,   num_workers=0)

    # ----------------------------------------------------------
    # SCHRITT 5: MODELL INITIALISIEREN
    # ----------------------------------------------------------
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"  Rechengerät: {device}")
    model = DroneClassifier().to(device)

    # pos_weight=2: Eine verpasste Drohne wird doppelt so stark bestraft wie
    # ein falscher Alarm. Das verschiebt das Modell Richtung höherer Recall.
    # Den Tradeoff steuern wir anschließend fein über den Threshold.
    # Erhöhen (z.B. 3–4) = noch mehr Recall, aber mehr Fehlalarme.
    POS_WEIGHT = 2.0
    criterion = nn.BCEWithLogitsLoss(
        pos_weight=torch.tensor([POS_WEIGHT], device=device)
    )

    # Label Smoothing: statt harten 0/1-Zielen verwenden wir 0.05/0.95.
    # Das verhindert, dass das Modell überentspannt in eine Richtung zieht.
    label_smoothing = 0.05

    # Tracking des besten Modells über alle Epochen
    best_balacc       = -1.0
    best_state        = None
    patience          = 5    # Wie viele Epochen ohne Verbesserung toleriert werden
    patience_counter  = 0

    # ----------------------------------------------------------
    # INNERE TRAININGS-SCHLEIFE (wird für Phase 1 und 2 verwendet)
    # ----------------------------------------------------------
    def run_epochs(optimizer, epochs, phase_name, scheduler=None):
        """
        Führt 'epochs' Trainings-Epochen aus und gibt das beste Modell zurück.

        Eine Epoche = einmal durch den gesamten Trainingsdatensatz.
        Nach jeder Epoche wird auf dem Validierungsset ausgewertet.
        """
        nonlocal_best = {
            "balacc":           best_balacc,
            "state":            best_state,
            "patience_counter": patience_counter,
        }

        for epoch in range(epochs):

            # ---- Trainingsphase ----
            model.train()  # Dropout aktiv, BatchNorm im Trainingsmodus
            total_loss = 0.0

            # Fortschrittsbalken für die Batches dieser Epoche
            batch_bar = tqdm(
                train_loader,
                desc=f"  {phase_name} Epoche {epoch+1}/{epochs} [Train]",
                unit="Batch",
                leave=False,
            )
            for X_batch, y_batch in batch_bar:
                X_batch = X_batch.to(device)

                # Label Smoothing: 0 → 0.05, 1 → 0.95
                y_smooth = y_batch.float() * (1.0 - 2 * label_smoothing) + label_smoothing
                y_smooth = y_smooth.to(device)

                # Mixup: mit 50% Wahrscheinlichkeit zwei Samples mischen.
                # Nur im Training, nicht bei der Validierung.
                if random.random() < 0.5:
                    X_batch, y_smooth = mixup_batch(X_batch, y_smooth, alpha=0.3)

                optimizer.zero_grad()          # Gradienten aus vorheriger Iteration löschen
                outputs = model(X_batch)       # Vorwärtsdurchlauf
                loss = criterion(outputs, y_smooth)  # Verlust berechnen
                loss.backward()               # Rückwärtsdurchlauf (Gradienten berechnen)
                optimizer.step()              # Gewichte aktualisieren

                total_loss += loss.item() * X_batch.size(0)

                # Aktuellen Verlust im Fortschrittsbalken anzeigen
                batch_bar.set_postfix({"loss": f"{loss.item():.4f}"})

            # Lernrate nach jeder Epoche anpassen (Cosine Annealing)
            if scheduler is not None:
                scheduler.step()

            avg_loss = total_loss / len(train_loader.dataset)

            # ---- Validierungsphase ----
            model.eval()
            all_y, all_p = [], []

            val_bar = tqdm(
                val_loader,
                desc=f"  {phase_name} Epoche {epoch+1}/{epochs} [Val]  ",
                unit="Batch",
                leave=False,
            )
            with torch.no_grad():
                for X_batch, y_batch in val_bar:
                    X_batch = X_batch.to(device)
                    logits  = model(X_batch)
                    probs   = torch.sigmoid(logits).cpu().numpy()
                    preds   = (probs >= 0.5).astype(np.float32)
                    all_y.extend(y_batch.numpy().tolist())
                    all_p.extend(preds.tolist())

            # Metriken berechnen
            bal_acc = balanced_accuracy_score(all_y, all_p)
            prec    = precision_score(all_y, all_p, zero_division=0)
            rec     = recall_score(all_y, all_p, zero_division=0)
            lr_now  = optimizer.param_groups[-1]["lr"]

            # Ergebnis-Zeile ausgeben
            print(
                f"  {phase_name} | Epoche {epoch+1:2d}/{epochs} "
                f"| Loss: {avg_loss:.4f} "
                f"| BalAcc: {bal_acc:.4f} "
                f"| Prec: {prec:.4f} "
                f"| Recall: {rec:.4f} "
                f"| LR: {lr_now:.2e}"
            )

            # Bestes Modell speichern
            if bal_acc > nonlocal_best["balacc"]:
                nonlocal_best["balacc"]           = bal_acc
                nonlocal_best["state"]            = {
                    k: v.detach().cpu().clone() for k, v in model.state_dict().items()
                }
                nonlocal_best["patience_counter"] = 0
                print(f"  ✓ Neues bestes Modell gespeichert (BalAcc={bal_acc:.4f})")
            else:
                nonlocal_best["patience_counter"] += 1
                remaining = patience - nonlocal_best["patience_counter"]
                print(f"  Keine Verbesserung ({nonlocal_best['patience_counter']}/{patience}, "
                      f"noch {remaining} Versuche)")

            # Early Stopping: Training abbrechen, wenn sich nichts verbessert
            if nonlocal_best["patience_counter"] >= patience:
                print(f"  → Early Stopping nach Epoche {epoch+1}")
                break

        return (
            nonlocal_best["balacc"],
            nonlocal_best["state"],
            nonlocal_best["patience_counter"],
        )

    # ----------------------------------------------------------
    # PHASE 1: NUR DEN KLASSIFIKATIONSKOPF TRAINIEREN
    # ----------------------------------------------------------
    print("\n[6/7] Training Phase 1: Klassifikationskopf ...")
    print("      (Feature-Extraktion eingefroren, nur neuer Kopf wird trainiert)")
    freeze_backbone(model)

    optimizer1  = torch.optim.Adam(
        filter(lambda p: p.requires_grad, model.parameters()), lr=1e-3
    )
    # CosineAnnealingLR: LR fällt nach einem Kosinus von lr=1e-3 auf eta_min=1e-5
    # Das verhindert zu große Schritte gegen Ende des Trainings.
    scheduler1  = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer1, T_max=8, eta_min=1e-5)

    best_balacc, best_state, patience_counter = run_epochs(
        optimizer1, epochs=8, phase_name="Phase1", scheduler=scheduler1
    )

    # ----------------------------------------------------------
    # PHASE 2: FINE-TUNING DER LETZTEN FEATURE-BLÖCKE
    # ----------------------------------------------------------
    print("\n[6/7] Training Phase 2: Fine-Tuning (letzte 4 Feature-Blöcke) ...")
    print("      (Niedrigere LR für Feature-Extraktion, höhere für den Kopf)")
    unfreeze_last_blocks(model, num_blocks=4)

    optimizer2 = torch.optim.Adam([
        {"params": model.backbone.features.parameters(),   "lr": 5e-6},
        {"params": model.backbone.classifier.parameters(), "lr": 5e-5},
    ])
    scheduler2 = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer2, T_max=15, eta_min=1e-7)

    best_balacc, best_state, patience_counter = run_epochs(
        optimizer2, epochs=15, phase_name="Phase2", scheduler=scheduler2
    )

    # ----------------------------------------------------------
    # PHASE 3: VOLLSTÄNDIGES FINE-TUNING ALLER SCHICHTEN
    # Mit sehr kleiner LR, damit die vortrainierten Gewichte nicht
    # zerstört werden. Nur sinnvoll, wenn Phase 2 noch nicht konvergiert ist.
    # ----------------------------------------------------------
    print("\n[6/7] Training Phase 3: Vollständiges Fine-Tuning aller Schichten ...")
    print("      (Alle Backbone-Schichten freigegeben, sehr niedrige LR)")
    for param in model.backbone.parameters():
        param.requires_grad = True

    optimizer3 = torch.optim.Adam([
        {"params": model.backbone.features.parameters(),   "lr": 1e-6},
        {"params": model.backbone.classifier.parameters(), "lr": 1e-5},
    ])
    scheduler3 = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer3, T_max=10, eta_min=1e-8)

    best_balacc, best_state, patience_counter = run_epochs(
        optimizer3, epochs=10, phase_name="Phase3", scheduler=scheduler3
    )

    # Bestes Modell wiederherstellen
    if best_state is not None:
        model.load_state_dict(best_state)
        print(f"\n  Bestes Modell geladen (BalAcc = {best_balacc:.4f})")

    # ----------------------------------------------------------
    # SCHRITT 6: EVALUIERUNG UND PLOTS
    # ----------------------------------------------------------
    print("\n[7/7] Erstelle Auswertungsplots ...")

    # Evaluierung auf ALLEN Validierungs-Segmenten (kein Harmonik-Filter)
    print("  Auswertung auf vollständigem Validierungsset ...")
    full_labels, full_probs = evaluate_loader(model, val_loader, device, desc="  Vollständiges Val-Set")

    # Threshold-Optimierung: findet den besten Schwellenwert auf dem Validierungsset.
    # "Bester F1" = ausgewogen; "Max Recall bei Prec≥90%" = für unsere Anwendung relevant.
    print("  Suche optimalen Threshold ...")
    f1_thresh, best_f1, recall_thresh, best_recall = find_optimal_threshold(
        full_labels, full_probs, min_precision=0.90
    )
    print(f"  → Bester F1-Threshold:              T={f1_thresh:.3f}  (F1={best_f1:.3f})")
    print(f"  → Max-Recall bei Prec≥90%-Threshold: T={recall_thresh:.3f} (Recall={best_recall:.3f})")

    # Konfusionsmatrix mit Threshold=0.5 (bisheriger Standard)
    plot_confusion(full_labels, full_probs, suffix="full_t050")
    # Konfusionsmatrix mit F1-optimiertem Threshold
    plot_confusion(full_labels, full_probs, suffix=f"full_f1thresh{f1_thresh:.2f}",
                   threshold=f1_thresh)
    # Konfusionsmatrix mit Recall-optimiertem Threshold
    plot_confusion(full_labels, full_probs, suffix=f"full_recallthresh{recall_thresh:.2f}",
                   threshold=recall_thresh)
    plot_probability_distribution(full_labels, full_probs, suffix="full")
    cm_abs = confusion_matrix(full_labels, (full_probs >= recall_thresh).astype(int), labels=[1, 0])

    # Evaluierung mit Harmonik-Filter: zeigt Performance auf "einfachen" Segmenten.
    # Wir filtern die vorberechneten Val-Spektrogramme nach Harmonik-Label.
    # Dafür laden wir die Drohnen-Segmente nochmal kurz, um den Filter anzuwenden.
    print("  Auswertung auf harmonisch gefilterten Drohnen-Segmenten ...")
    preclass_cache = _cache_key("preclass_segs", **seg_cache_params)
    if USE_CACHE and preclass_cache.exists():
        preclass_segs_raw, preclass_labels_raw = _load_cache(preclass_cache)
    else:
        preclass_drone_segs, preclass_drone_labels = load_segments(
            os.path.join(DATA_ROOT, "VALIDATION", "drone"),
            label=1, pre_classify=True, noise_pool=None, rir_pool=None, augment=False,
        )
        preclass_no_segs, preclass_no_labels = load_segments(
            os.path.join(DATA_ROOT, "VALIDATION", "no drone"),
            label=0, pre_classify=False, noise_pool=None, rir_pool=None, augment=False,
        )
        preclass_segs_raw   = preclass_drone_segs + preclass_no_segs
        preclass_labels_raw = preclass_drone_labels + preclass_no_labels
        _save_cache((preclass_segs_raw, preclass_labels_raw), preclass_cache)

    preclass_spec_cache = _cache_key("preclass_specs", **spec_cache_params)
    if USE_CACHE and preclass_spec_cache.exists():
        preclass_specs = _load_cache(preclass_spec_cache)
    else:
        preclass_specs = precompute_spectrograms(preclass_segs_raw, desc="Preclass-Spektrogramme")
        _save_cache(preclass_specs, preclass_spec_cache)

    preclass_dataset = DroneDataset(preclass_specs, preclass_labels_raw, augment=False)
    preclass_loader  = DataLoader(preclass_dataset, batch_size=16, shuffle=False, num_workers=0)
    preclass_labels, preclass_probs = evaluate_loader(
        model, preclass_loader, device, desc="  Gefiltertes Val-Set"
    )
    plot_confusion(preclass_labels, preclass_probs, suffix="pre_classified")
    plot_probability_distribution(preclass_labels, preclass_probs, suffix="pre_classified")

    # Modell exportieren
    export_to_tflite(model, device, input_shape=(1, 3, IMG_SIZE, IMG_SIZE))

    print("\nTraining abgeschlossen.")
    print(f"Beste balanced Accuracy: {best_balacc:.4f}")

    if return_outputs:
        return cm_abs, model, full_probs

    return None


# ============================================================
# EINSTIEGSPUNKT
# ============================================================

if __name__ == "__main__":
    # Wird ausgeführt, wenn das Skript direkt gestartet wird:
    #   python train_drone_cnn.py
    # Nicht ausgeführt, wenn es von augment_sweep.py importiert wird.
    train_model()
